""" Now we have to change the data type of the GarageCars. because the cars could not be in the float.
but before it we have to fix the all null values before fixing the null values then  data type cant be change."""

df["GarageCars"] = df["GarageCars"].fillna(df["GarageCars"].median())



df["GarageCars"] = df["GarageCars"].astype(int)


df["GarageCars"].dtype


df.isnull().sum()


df["Condition"] = df["Condition"].fillna(df["Condition"].mode()[0])


df["Condition"].isnull().sum()


df["Furnishing"] = df["Furnishing"].fillna(df["Furnishing"].mode()[0])


df["Furnishing"].isnull().sum()


df["BasementArea"] = df["BasementArea"].fillna(df["BasementArea"].median)


df["BasementArea"].isnull().sum()


df['LotArea'] = df['LotArea'].fillna(df['LotArea'].median())


df["LotArea"].isnull().sum()


